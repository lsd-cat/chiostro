{{ ansible_managed | comment }}

server {
	listen 80;
	listen [::]:80;
	server_name {{ chiostro_domain }};

	# ACME http-01 served locally (unicast host).
	location ^~ /.well-known/acme-challenge/ {
		root {{ chiostro_acme_webroot | regex_replace('/$', '') }};
	}
	location / { return 301 https://{{ chiostro_domain }}$request_uri; }
}

server {
	listen 443 ssl http2;
	listen [::]:443 ssl http2;
	server_name {{ chiostro_domain }};   # one bundle, one config: the path picks the tool

	access_log off;   # a call relay: no per-request logging of who talks to whom
	error_log  {{ chiostro_logs }}/error_log error;

	ssl_certificate     {{ chiostro_ssl_cert }};
	ssl_certificate_key {{ chiostro_ssl_key }};
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_prefer_server_ciphers on;
	add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
	# Strict CSP, same as the app's own server: no inline script or style; blob: frames are the shared-PDF viewer.
	# Strict CSP, same as the dev server: no inline script or style; blob: frames are the shared-PDF viewer,
	# blob: images are decrypted attachments, https: images are the pad's hot-linked ones.
	add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https:; media-src blob:; connect-src 'self' {{ chiostro_connect_src }}; worker-src 'self'; frame-src 'self' blob: {{ chiostro_frame_src }}; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header X-Frame-Options "DENY" always;
	add_header Referrer-Policy "no-referrer" always;
	add_header Cache-Control no-cache always;   # revalidate every time, so a deploy is live on the next reload

	root {{ chiostro_web_dir }};
	include snippets/chiostro-store.conf;   # $data and, in bucket mode, the bucket and /_s3/
	types { text/html html; text/css css; text/javascript js; application/json json; image/svg+xml svg; image/png png; image/webp webp; }
	default_type application/octet-stream;

	location = / { try_files /index.html =404; }               # the shell: the landing page
	location ~ "^/[a-z]+/$" { try_files /index.html =404; }   # every tool is the same shell; the path picks the module
	location = /config.json { try_files /config.json =404; }
	location ~ "^/([a-z0-9-]+/){0,3}[a-z0-9-]+\.(js|css|svg|png|webp)$" { try_files $uri =404; }   # the bundle, the extensions, themes/ (logos)
	location ^~ /texmf/ { alias {{ chiostro_web_dir }}/texmf/; add_header Cache-Control "public, max-age=31536000, immutable"; }   # TeX Live files for PDF export (tstex), if deployed

	# Blind relay: text + binary WebSocket frames forwarded between peers of a room. Lua state is
	# per worker (worker_processes 1). 256 KB message cap, bounded queues, backpressure to senders.
	location ~ "^/ws/(?<app>[a-z0-9]{2,8})/(?<room>[0-9a-f]{64})$" {
		content_by_lua_file {{ chiostro_app_dir }}/relay.lua;
	}
	# Blind write-once store: sealed bytes, one file per slot, an index per room; nginx spools the
	# body next to the store so a put is a rename; GETs are streamed by nginx (slots never change).
	location ~ "^/blob/(?<app>[a-z0-9]{2,8})/(?<room>[0-9a-f]{64})/(?<slot>[0-9a-f]{8,32}(\.[0-9]{1,6})?|index)$" {
		client_max_body_size {{ chiostro_chunk_max }};
		client_body_in_file_only on;
		client_body_temp_path {{ chiostro_data_dir }}/tmp;
		content_by_lua_file {{ chiostro_app_dir }}/relay.lua;
	}
	# add_header in a location replaces the server's set: the blob locations repeat nosniff and say "bytes, download" so no blob is ever a page on this origin
	location ^~ /_blob/ { internal; alias {{ chiostro_data_dir }}/; add_header Cache-Control "private, max-age=31536000, immutable"; add_header Content-Disposition attachment; add_header X-Content-Type-Options nosniff always; }
	location ^~ /_index/ { internal; alias {{ chiostro_data_dir }}/; add_header Cache-Control no-cache always; add_header X-Content-Type-Options nosniff always; }
}
